    {
      "name": "Q4-GET User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "const user = response.data;\r",
              "\r",
              "const expectedFirstName = \"Janet\";\r",
              "const expectedLastName = \"Weaver\";\r",
              "const expectedEmail = \"janet.weaver@reqres.in\";\r",
              "\r",
              "pm.test(\"User ID matches\", function () {\r",
              "    pm.expect(user.id).to.eql(2);\r",
              "});\r",
              "\r",
              "pm.test(\"First name matches\", function () {\r",
              "    pm.expect(user.first_name).to.eql(expectedFirstName);\r",
              "});\r",
              "\r",
              "pm.test(\"Last name matches\", function () {\r",
              "    pm.expect(user.last_name).to.eql(expectedLastName);\r",
              "});\r",
              "\r",
              "pm.test(\"Email matches\", function () {\r",
              "    pm.expect(user.email).to.eql(expectedEmail);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
