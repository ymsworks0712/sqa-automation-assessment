    {
      "name": "Q6 - PATCH User",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "pm.sendRequest({\r",
              "    url: pm.variables.replaceIn('{{base_url}}/api/users/2'),\r",
              "    method: 'GET',\r",
              "    header: {\r",
              "        'x-api-key': pm.environment.get('api_key')\r",
              "    }\r",
              "}, function (err, res) {\r",
              "\r",
              "    if (err) {\r",
              "        console.log(\"Failed to get original user:\", err);\r",
              "        return;\r",
              "    }\r",
              "\r",
              "    const originalUser = res.json().data;\r",
              "\r",
              "    pm.environment.set(\"originalName\", originalUser.first_name);\r",
              "    pm.environment.set(\"originalEmail\", originalUser.email);\r",
              "\r",
              "    console.log(\"Original name:\", originalUser.first_name);\r",
              "    console.log(\"Original email:\", originalUser.email);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Job was updated correctly\", function () {\r",
              "    pm.expect(response.job).to.eql(\"Senior QA Engineer\");\r",
              "});\r",
              "\r",
              "pm.test(\"updatedAt exists\", function () {\r",
              "    pm.expect(response.updatedAt).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"updatedAt is a valid timestamp\", function () {\r",
              "    const updatedAt = new Date(response.updatedAt);\r",
              "\r",
              "    pm.expect(updatedAt.toString()).to.not.equal(\"Invalid Date\");\r",
              "});\r",
              "\r",
              "\r",
              "pm.sendRequest({\r",
              "    url: pm.variables.replaceIn('{{base_url}}/api/users/2'),\r",
              "    method: 'GET',\r",
              "    header: {\r",
              "        'x-api-key': pm.environment.get('api_key')\r",
              "    }\r",
              "}, function (err, res) {\r",
              "\r",
              "    if (err) {\r",
              "        console.log(\"Failed to verify updated user:\", err);\r",
              "        return;\r",
              "    }\r",
              "\r",
              "    const updatedUser = res.json().data;\r",
              "\r",
              "    pm.test(\"Name remained unchanged after PATCH\", function () {\r",
              "        pm.expect(updatedUser.first_name)\r",
              "            .to.eql(pm.environment.get(\"originalName\"));\r",
              "    });\r",
              "\r",
              "    pm.test(\"Email remained unchanged after PATCH\", function () {\r",
              "        pm.expect(updatedUser.email)\r",
              "            .to.eql(pm.environment.get(\"originalEmail\"));\r",
              "    });\r",
              "});\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "x-api-key",
            "value": "{{api_key}}",
            "type": "text"
