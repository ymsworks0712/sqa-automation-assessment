    {
      "name": "Q5 - PUT Update User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Updated name is correct\", function () {\r",
              "    pm.expect(response.name).to.eql(\"Yasin Mahmood Sakib\");\r",
              "});\r",
              "\r",
              "pm.test(\"Updated job is correct\", function () {\r",
              "    pm.expect(response.job).to.eql(\"QA Automation Engineer\");\r",
              "});\r",
              "\r",
              "pm.test(\"updatedAt exists\", function () {\r",
              "    pm.expect(response.updatedAt).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"updatedAt is not empty\", function () {\r",
              "    pm.expect(response.updatedAt).to.be.a(\"string\");\r",
              "    pm.expect(response.updatedAt).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"updatedAt is a valid timestamp\", function () {\r",
              "    const updatedAt = new Date(response.updatedAt);\r",
              "\r",
              "    pm.expect(updatedAt.toString()).to.not.equal(\"Invalid Date\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
