    {
      "name": "Q8 - Bad Request Validation",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 4xx\", function () {\r\n    pm.expect(pm.response.code).to.be.within(400, 499);\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const originalUserId = pm.environment.get(\"userId\");\r\n\r\nconst invalidUserId = Number(originalUserId) + 999999;\r\n\r\npm.environment.set(\"invalidUserId\", invalidUserId);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/{{invalidUserId}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "{{invalidUserId}}"
          ]
        }
      },
