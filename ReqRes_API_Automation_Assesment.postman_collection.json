    {
      "name": "Q3-Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Response contains auth token\", function () {\r",
              "    pm.expect(response.token).to.exist;\r",
              "});\r",
              "\r",
              "pm.test(\"Auth token is not empty\", function () {\r",
              "    pm.expect(response.token).to.be.a(\"string\");\r",
              "    pm.expect(response.token).to.not.be.empty;\r",
              "});\r",
              "\r",
              "pm.environment.set(\"authToken\", response.token);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
